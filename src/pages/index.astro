---
// Custom landing page (English) — bypasses Starlight's docs layout
import '../styles/landing.css';
import docsContract from '../data/docs-contract.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			"name": "memtomem",
			"description": "MCP-native memory infrastructure for AI agents. STM + LTM separated architecture for cross-session, cross-agent knowledge sharing.",
			"url": "https://memtomem.com/",
			"inLanguage": "en",
			"softwareVersion": docsContract.core.version,
			"applicationCategory": "DeveloperApplication",
			"operatingSystem": "Cross-platform",
			"license": "https://opensource.org/licenses/Apache-2.0",
			"sameAs": [
				"https://github.com/memtomem/memtomem"
			],
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"author": {
				"@type": "Organization",
				"name": "DAPADA Inc."
			}
		},
		{
			"@type": "WebSite",
			"name": "memtomem",
			"url": "https://memtomem.com/",
			"inLanguage": "en"
		}
	]
};
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>memtomem — Long &amp; Short-Term Memory Infrastructure for AI Agents</title>
	<meta name="description" content="Turn your notes, docs, and code into searchable, local-first memory that MCP-compatible AI agents can use across sessions and agents." />
	<meta name="theme-color" content="#534AB7" />
	<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	<link rel="canonical" href="https://memtomem.com/" />
	<link rel="alternate" hreflang="en" href="https://memtomem.com/" />
	<link rel="alternate" hreflang="ko" href="https://memtomem.com/ko/" />
	<link rel="alternate" hreflang="x-default" href="https://memtomem.com/" />
	<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://memtomem.com/" />
	<meta property="og:title" content="memtomem — Long &amp; Short-Term Memory Infrastructure for AI Agents" />
	<meta property="og:description" content="Turn your notes, docs, and code into searchable, local-first memory that MCP-compatible AI agents can use across sessions and agents." />
	<meta property="og:site_name" content="memtomem" />
	<meta property="og:image" content="https://memtomem.com/og-image.png" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:locale" content="en_US" />
	<meta property="og:locale:alternate" content="ko_KR" />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="memtomem — Long &amp; Short-Term Memory Infrastructure for AI Agents" />
	<meta name="twitter:description" content="Turn your notes, docs, and code into searchable, local-first memory that MCP-compatible AI agents can use across sessions and agents." />
	<meta name="twitter:image" content="https://memtomem.com/og-image.png" />

	<!-- JSON-LD -->
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</head>
<body>

<nav class="nav">
	<a href={`${base}/`} class="nav-logo"><span>mem</span>to<span>mem</span></a>
	<div class="nav-links">
		<a href="#architecture">Architecture</a>
		<a href="https://github.com/memtomem/memtomem">GitHub</a>
		<span class="nav-lang"><a href={`${base}/ko/`}>KO</a></span>
	</div>
	<a class="nav-cta" href={`${base}/guides/quickstart/`}>Get started</a>
</nav>

<main>
<section class="hero">
	<div class="hero-badge">Memory infrastructure for AI agents · Apache 2.0</div>
	<h1>Yesterday's work in <span class="nowrap">Claude Code</span>,<br /><em>picked up in Codex today</em></h1>
	<p class="hero-sub">Whether you return to the same tool or switch to another, your project's memory stays in Markdown files you own. Each step below runs only when you invoke it.</p>
	<ol class="loop" role="list">
		<li class="loop-step accent">
			<div class="loop-when">End of a session · Claude Code</div>
			<code class="loop-cmd">/memtomem:handoff save</code>
			<p>Writes one checkpoint record into the project's <code>.memtomem/memories.local</code>.</p>
		</li>
		<li class="loop-step teal">
			<div class="loop-when">Next session · Codex CLI</div>
			<code class="loop-cmd">$memtomem-brief</code>
			<code class="loop-cmd">$memtomem-handoff resume</code>
			<p>Lists active handoffs, then loads one and checks it against the live commit.</p>
		</li>
		<li class="loop-step coral">
			<div class="loop-when">After a few commits · Claude Code</div>
			<code class="loop-cmd">/memtomem:update</code>
			<p>Saves decisions, bug causes, and preferences back into the same files.</p>
		</li>
	</ol>
	<div class="hero-install" id="install">
		<span class="dollar" aria-hidden="true">$</span>
		<code id="install-cmd">uv tool install 'memtomem[all]'</code>
		<button type="button" class="copy-btn" data-copy="install-cmd" data-label="Copy" data-done="Copied" data-fail="Select it" hidden>Copy</button>
	</div>
	<p class="install-steps">
		<span>Install</span><span class="step-sep" aria-hidden="true"></span><code>mm init</code><span class="step-sep" aria-hidden="true"></span><code>mm add</code><span class="step-sep" aria-hidden="true"></span><code>mm search</code>
		<a href={`${base}/guides/quickstart/`}>10-minute Quick Start →</a>
	</p>
	<p class="sr-only" id="copy-status" aria-live="polite"></p>
</section>

<section class="section">
	<div class="section-inner">
		<h2 class="section-head"><span class="lead">A memory layer.</span> Tools have MCP, safety has Guardrails, observability has Langfuse. Memory needs a layer of its own.</h2>
		<div class="feature-grid">
			<a class="feature-card accent" href={`${base}/ltm/hybrid-search/`}>
				<h3>Searchable Long-Term Memory</h3>
				<p>Finds exact identifiers and meaning-based matches across your notes, docs, and code. The minimal preset searches by keyword; enable embeddings to fuse BM25 with dense vectors.</p>
				<span class="tag tag-ltm">LTM</span>
			</a>
			<a class="feature-card teal" href={`${base}/ltm/project-workflows/`}>
				<h3>Memory Across Sessions &amp; Agents</h3>
				<p>Carry work between Claude Code, Codex, and Antigravity CLI with <code>handoff</code>, <code>brief</code>, and <code>update</code>. Namespaces scope searches; they are not access-control boundaries.</p>
				<span class="tag tag-ltm">LTM</span>
			</a>
			<a class="feature-card coral" href={`${base}/ltm/context-gateway/`}>
				<h3>Context Gateway</h3>
				<p>Keep master skills, commands, and subagents in the <code>.memtomem/</code> Store. Pull runtime copies in after a preview, then Push the reviewed version to selected runtimes.</p>
				<span class="tag tag-ltm">LTM</span>
			</a>
			<a class="feature-card amber" href={`${base}/stm/surfacing/`}>
				<h3>Proactive Surfacing</h3>
				<p>The optional STM proxy can attach relevant memories to the MCP tool responses it routes. Each item carries an id, so your agent can rate or invalidate it.</p>
				<span class="tag tag-stm">STM</span>
			</a>
			<a class="feature-card blue" href={`${base}/stm/compression/`}>
				<h3>Token-Aware Compression</h3>
				<p>STM can compress responses from the MCP tools it routes before they reach your agent. Configured budgets and gates decide when, and actual savings depend on the response.</p>
				<span class="tag tag-stm">STM</span>
			</a>
			<a class="feature-card green" href={`${base}/guides/privacy/`}>
				<h3>Local-First &amp; Private</h3>
				<p>SQLite storage and local ONNX inference need no GPU or cloud account. Ollama, OpenAI-compatible, Cohere, and Langfuse integrations are optional and can contact the services you configure.</p>
				<span class="tag tag-guide">LTM + STM</span>
			</a>
		</div>
	</div>
</section>

<section class="section" id="architecture">
	<div class="section-inner">
		<h2 class="section-head"><span class="lead">Two layers.</span> A long-term memory server and an optional STM proxy, connected over MCP.</h2>
		<div class="section-actions">
			<a class="btn-small" href={`${base}/ltm/overview/`}>LTM Overview</a>
			<a class="btn-small ghost" href={`${base}/stm/overview/`}>STM Overview</a>
		</div>
		<div class="arch-diagram">
			<div class="arch-tier-label">Core AI Runtimes / Others</div>
			<div class="arch-row">
				<div class="arch-node">Claude Code</div>
				<div class="arch-node">Codex CLI</div>
				<div class="arch-node">Antigravity CLI</div>
				<div class="arch-node">Other MCP clients</div>
			</div>
			<div class="arch-connector"><span>MCP</span></div>
			<div class="arch-row">
				<div class="arch-node teal arch-node-wide">
					<div class="arch-node-title">memtomem-stm</div>
					<div class="arch-node-sub">STM Proxy</div>
					<div class="arch-node-detail">CLEAN &rarr; COMPRESS &rarr; SURFACE</div>
				</div>
			</div>
			<div class="arch-connector-pair">
				<div class="arch-connector"><span>Surfacing</span></div>
				<div class="arch-connector"><span>MCP</span></div>
			</div>
			<div class="arch-row">
				<div class="arch-node accent arch-node-half">
					<div class="arch-node-title">memtomem</div>
					<div class="arch-node-sub">LTM Server</div>
					<div class="arch-node-detail">9 core MCP Tools</div>
				</div>
				<div class="arch-node arch-node-half">
					<div class="arch-node-title">Upstream MCP Servers</div>
					<div class="arch-node-detail">filesystem, GitHub, …</div>
				</div>
			</div>
		</div>
		<p class="arch-caption">Other MCP clients and framework adapters connect through the same MCP standard.</p>
	</div>
</section>

<section class="section">
	<div class="section-inner">
		<h2 class="section-head"><span class="lead">Next steps.</span> Start with the ten-minute check, then expand to the task you need.</h2>
		<div class="next-grid">
			<a href={`${base}/guides/quickstart/`} class="doc-card">
				<h3>Quick Start</h3>
				<p>Install LTM, save one memory, and find it again.</p>
				<span class="tag tag-guide">Getting Started</span>
			</a>
			<a href={`${base}/guides/connect-ai-client/`} class="doc-card">
				<h3>Connect an AI Client</h3>
				<p>Connect Claude Code, Codex, or another MCP client and verify <code>mem_status</code>.</p>
				<span class="tag tag-guide">Connection</span>
			</a>
			<a href={`${base}/use-cases/vibe-coding/`} class="doc-card">
				<h3>Recover a coding decision and its source</h3>
				<p>Retrieve a saved reason and its ADR source in a new session.</p>
				<span class="tag tag-ltm">Use case</span>
			</a>
			<a href={`${base}/use-cases/langgraph/`} class="doc-card">
				<h3>Build LangGraph memory without a model</h3>
				<p>Start with two beginner notebooks that run without an API key.</p>
				<span class="tag tag-ltm">Use case</span>
			</a>
		</div>
	</div>
</section>

</main>

<footer class="footer">
	<div class="footer-cols">
		<div class="footer-brand">
			<a href={`${base}/`} class="nav-logo"><span>mem</span>to<span>mem</span></a>
			<p>MCP-native memory infrastructure for AI agents</p>
		</div>
		<nav class="footer-col" aria-label="Get started">
			<h2>Get started</h2>
			<a href={`${base}/guides/quickstart/`}>Quick Start</a>
			<a href={`${base}/guides/connect-ai-client/`}>Connect an AI Client</a>
			<a href={`${base}/guides/installation/`}>Installation</a>
			<a href={`${base}/guides/choose-your-path/`}>Choose Your Path</a>
		</nav>
		<nav class="footer-col" aria-label="Guides">
			<h2>Guides</h2>
			<a href={`${base}/ltm/memory-persistence/`}>Memory Across Sessions</a>
			<a href={`${base}/ltm/index-and-import/`}>Index &amp; Import Content</a>
			<a href={`${base}/stm/first-proxy/`}>Add STM to an MCP Server</a>
			<a href={`${base}/guides/troubleshooting/`}>Troubleshooting</a>
		</nav>
		<nav class="footer-col" aria-label="Project">
			<h2>Project</h2>
			<a href="https://github.com/memtomem/memtomem">GitHub (LTM)</a>
			<a href="https://github.com/memtomem/memtomem-stm">GitHub (STM)</a>
			<a href="https://pypi.org/project/memtomem/">PyPI</a>
		</nav>
	</div>
	<div class="footer-bottom">DAPADA Inc. — Apache 2.0 · memtomem v{docsContract.core.version} · memtomem-stm v{docsContract.stm.version}</div>
</footer>

<script>
	import '../scripts/copy-button';
</script>

</body>
</html>
