---
// Custom landing page (Korean) — bypasses Starlight's docs layout
import '../../styles/landing.css';
import docsContract from '../../data/docs-contract.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			"name": "memtomem",
			"description": "AI 도구를 위한 MCP 기반 기억 인프라입니다. STM과 LTM을 분리해 세션과 도구가 바뀌어도 기억을 이어서 사용할 수 있습니다.",
			"url": "https://memtomem.com/ko/",
			"inLanguage": "ko",
			"softwareVersion": docsContract.core.version,
			"applicationCategory": "DeveloperApplication",
			"operatingSystem": "Cross-platform",
			"license": "https://opensource.org/licenses/Apache-2.0",
			"sameAs": [
				"https://github.com/memtomem/memtomem"
			],
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"author": {
				"@type": "Organization",
				"name": "DAPADA Inc."
			}
		},
		{
			"@type": "WebSite",
			"name": "memtomem",
			"url": "https://memtomem.com/",
			"inLanguage": "ko"
		}
	]
};
---
<html lang="ko">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>memtomem — AI 에이전트를 위한 장단기 기억 인프라</title>
	<meta name="description" content="노트·문서·코드를 MCP 호환 AI 에이전트가 검색할 수 있는 로컬 우선 기억(메모리)으로 바꿉니다. 세션이나 에이전트가 바뀌어도 같은 기억을 이어서 사용합니다." />
	<meta name="theme-color" content="#534AB7" />
	<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	<link rel="canonical" href="https://memtomem.com/ko/" />
	<link rel="alternate" hreflang="en" href="https://memtomem.com/" />
	<link rel="alternate" hreflang="ko" href="https://memtomem.com/ko/" />
	<link rel="alternate" hreflang="x-default" href="https://memtomem.com/" />
	<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://memtomem.com/ko/" />
	<meta property="og:title" content="memtomem — AI 에이전트를 위한 장단기 기억 인프라" />
	<meta property="og:description" content="노트·문서·코드를 MCP 호환 AI 에이전트가 검색할 수 있는 로컬 우선 기억(메모리)으로 바꿉니다. 세션이나 에이전트가 바뀌어도 같은 기억을 이어서 사용합니다." />
	<meta property="og:site_name" content="memtomem" />
	<meta property="og:image" content="https://memtomem.com/og-image-ko.png" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:locale" content="ko_KR" />
	<meta property="og:locale:alternate" content="en_US" />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="memtomem — AI 에이전트를 위한 장단기 기억 인프라" />
	<meta name="twitter:description" content="노트·문서·코드를 MCP 호환 AI 에이전트가 검색할 수 있는 로컬 우선 기억(메모리)으로 바꿉니다. 세션이나 에이전트가 바뀌어도 같은 기억을 이어서 사용합니다." />
	<meta name="twitter:image" content="https://memtomem.com/og-image-ko.png" />

	<!-- JSON-LD 구조화 데이터 -->
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</head>
<body>

<nav class="nav">
	<a href={`${base}/ko/`} class="nav-logo"><span>mem</span>to<span>mem</span></a>
	<div class="nav-links">
		<a href="#architecture">구조</a>
		<a href="https://github.com/memtomem/memtomem">GitHub</a>
		<span class="nav-lang"><a href={`${base}/`}>EN</a></span>
	</div>
	<a class="nav-cta" href={`${base}/ko/guides/quickstart/`}>시작하기</a>
</nav>

<main>
<section class="hero">
	<div class="hero-badge">AI 에이전트를 위한 기억 인프라 · Apache 2.0</div>
	<h1>어제 <span class="nowrap">Claude Code</span>에서 하던 작업을<br /><em>오늘 Codex에서 이어 갑니다</em></h1>
	<p class="hero-sub">같은 도구로 돌아오든 다른 도구로 옮기든, 프로젝트의 기억은 사용자가 소유한 Markdown 파일에 남습니다. 아래 세 단계는 직접 호출할 때만 실행됩니다.</p>
	<ol class="loop" role="list">
		<li class="loop-step accent">
			<div class="loop-when">세션 종료 · Claude Code</div>
			<code class="loop-cmd">/memtomem:handoff save</code>
			<p>프로젝트의 <code>.memtomem/memories.local</code>에 진행 상황을 기록합니다.</p>
		</li>
		<li class="loop-step teal">
			<div class="loop-when">다음 세션 · Codex CLI</div>
			<code class="loop-cmd">$memtomem-brief</code>
			<code class="loop-cmd">$memtomem-handoff resume</code>
			<p>대기 중인 handoff를 확인합니다. 불러온 기록은 현재 커밋과 맞는지 검사합니다.</p>
		</li>
		<li class="loop-step coral">
			<div class="loop-when">커밋 몇 건 이후 · Claude Code</div>
			<code class="loop-cmd">/memtomem:update</code>
			<p>결정, 버그 원인, 선호를 같은 파일에 다시 저장합니다.</p>
		</li>
	</ol>
	<div class="hero-install" id="install">
		<span class="dollar" aria-hidden="true">$</span>
		<code id="install-cmd">uv tool install 'memtomem[all]'</code>
		<button type="button" class="copy-btn" data-copy="install-cmd" data-label="복사" data-done="복사함" data-fail="직접 선택하세요" hidden>복사</button>
	</div>
	<p class="install-steps">
		<span>설치</span><span class="step-sep" aria-hidden="true"></span><code>mm init</code><span class="step-sep" aria-hidden="true"></span><code>mm add</code><span class="step-sep" aria-hidden="true"></span><code>mm search</code>
		<a href={`${base}/ko/guides/quickstart/`}>10분 빠른 시작 →</a>
	</p>
	<p class="sr-only" id="copy-status" aria-live="polite"></p>
</section>

<section class="section">
	<div class="section-inner">
		<h2 class="section-head"><span class="lead">기억 계층.</span> 도구 연동의 MCP, 안전장치의 Guardrails, 관측의 Langfuse처럼 기억에도 전용 계층이 필요합니다.</h2>
		<div class="feature-grid">
			<a class="feature-card accent" href={`${base}/ko/ltm/hybrid-search/`}>
				<h3>장기 기억 검색</h3>
				<p>함수 이름 같은 정확한 단어와, 표현은 달라도 뜻이 같은 문장을 함께 찾습니다. Minimal 설정은 키워드 검색만 사용하고, 임베딩을 켜면 BM25와 벡터 검색을 결합합니다.</p>
				<span class="tag tag-ltm">LTM</span>
			</a>
			<a class="feature-card teal" href={`${base}/ko/ltm/project-workflows/`}>
				<h3>세션·에이전트 경계를 넘어</h3>
				<p><code>handoff</code>, <code>brief</code>, <code>update</code>로 Claude Code, Codex, Antigravity CLI 사이에서 작업을 이어 갑니다. 네임스페이스는 검색 범위를 나눌 뿐, 접근 제어 경계는 아닙니다.</p>
				<span class="tag tag-ltm">LTM</span>
			</a>
			<a class="feature-card coral" href={`${base}/ko/ltm/context-gateway/`}>
				<h3>Context Gateway</h3>
				<p>스킬·명령·서브에이전트의 기준본을 <code>.memtomem/</code> Store에 보관합니다. 실행 환경의 파일은 미리 확인한 뒤 Pull로 가져오고, 검토한 기준본은 Push로 보냅니다.</p>
				<span class="tag tag-ltm">LTM</span>
			</a>
			<a class="feature-card amber" href={`${base}/ko/stm/surfacing/`}>
				<h3>능동적 서피싱</h3>
				<p>선택 사항인 STM 프록시는 중계하는 MCP 도구 응답에 관련 기억을 함께 전달할 수 있습니다. 항목마다 식별자가 있어 에이전트가 평가하거나 제외할 수 있습니다.</p>
				<span class="tag tag-stm">STM</span>
			</a>
			<a class="feature-card blue" href={`${base}/ko/stm/compression/`}>
				<h3>토큰 인식 압축</h3>
				<p>STM은 중계하는 MCP 도구 응답을 에이전트에 전달하기 전에 압축할 수 있습니다. 설정한 응답 예산과 조건에 따라 동작하며, 실제 절감량은 응답에 따라 달라집니다.</p>
				<span class="tag tag-stm">STM</span>
			</a>
			<a class="feature-card green" href={`${base}/ko/guides/privacy/`}>
				<h3>로컬 우선 · 정보 보호</h3>
				<p>SQLite 저장과 로컬 ONNX 추론에는 GPU나 클라우드 계정이 필요 없습니다. Ollama·OpenAI 호환·Cohere·Langfuse 연동은 선택 사항이며, 설정한 서비스와 통신할 수 있습니다.</p>
				<span class="tag tag-guide">LTM + STM</span>
			</a>
		</div>
	</div>
</section>

<section class="section" id="architecture">
	<div class="section-inner">
		<h2 class="section-head"><span class="lead">두 계층.</span> 장기 기억 서버와 선택형 STM 프록시를 MCP로 연결합니다.</h2>
		<div class="section-actions">
			<a class="btn-small" href={`${base}/ko/ltm/overview/`}>LTM 개요</a>
			<a class="btn-small ghost" href={`${base}/ko/stm/overview/`}>STM 개요</a>
		</div>
		<div class="arch-diagram">
			<div class="arch-tier-label">주요 AI 도구 / 기타</div>
			<div class="arch-row">
				<div class="arch-node">Claude Code</div>
				<div class="arch-node">Codex CLI</div>
				<div class="arch-node">Antigravity CLI</div>
				<div class="arch-node">기타 MCP 클라이언트</div>
			</div>
			<div class="arch-connector"><span>MCP</span></div>
			<div class="arch-row">
				<div class="arch-node teal arch-node-wide">
					<div class="arch-node-title">memtomem-stm</div>
					<div class="arch-node-sub">STM 프록시</div>
					<div class="arch-node-detail">CLEAN &rarr; COMPRESS &rarr; SURFACE</div>
				</div>
			</div>
			<div class="arch-connector-pair">
				<div class="arch-connector"><span>관련 기억 검색</span></div>
				<div class="arch-connector"><span>MCP</span></div>
			</div>
			<div class="arch-row">
				<div class="arch-node accent arch-node-half">
					<div class="arch-node-title">memtomem</div>
					<div class="arch-node-sub">LTM 서버</div>
					<div class="arch-node-detail">Core MCP 도구 9개</div>
				</div>
				<div class="arch-node arch-node-half">
					<div class="arch-node-title">연결한 MCP 서버</div>
					<div class="arch-node-detail">filesystem, GitHub, …</div>
				</div>
			</div>
		</div>
		<p class="arch-caption">그 밖의 MCP 클라이언트와 프레임워크 어댑터도 같은 MCP 표준으로 연결합니다.</p>
	</div>
</section>

<section class="section">
	<div class="section-inner">
		<h2 class="section-head"><span class="lead">다음 단계.</span> 10분 기본 검증부터 시작하고, 필요한 작업으로 넓혀 갑니다.</h2>
		<div class="next-grid">
			<a href={`${base}/ko/guides/quickstart/`} class="doc-card">
				<h3>빠른 시작</h3>
				<p>LTM을 설치하고 기억 하나를 저장한 뒤 다시 찾습니다.</p>
				<span class="tag tag-guide">처음 시작</span>
			</a>
			<a href={`${base}/ko/guides/connect-ai-client/`} class="doc-card">
				<h3>AI 클라이언트 연결</h3>
				<p>Claude Code, Codex 등 MCP 클라이언트를 연결하고 <code>mem_status</code>를 확인합니다.</p>
				<span class="tag tag-guide">연결</span>
			</a>
			<a href={`${base}/ko/use-cases/vibe-coding/`} class="doc-card">
				<h3>코딩 결정과 근거 문서 다시 찾기</h3>
				<p>저장한 이유와 ADR 출처를 새 세션에서 다시 찾습니다.</p>
				<span class="tag tag-ltm">활용 사례</span>
			</a>
			<a href={`${base}/ko/use-cases/langgraph/`} class="doc-card">
				<h3>모델 없이 시작하는 LangGraph 기억</h3>
				<p>API 키 없이 실행하는 입문 노트북 두 개로 시작합니다.</p>
				<span class="tag tag-ltm">활용 사례</span>
			</a>
		</div>
	</div>
</section>

</main>

<footer class="footer">
	<div class="footer-cols">
		<div class="footer-brand">
			<a href={`${base}/ko/`} class="nav-logo"><span>mem</span>to<span>mem</span></a>
			<p>AI 에이전트를 위한 MCP 기반 기억 인프라</p>
		</div>
		<nav class="footer-col" aria-label="시작하기">
			<h2>시작하기</h2>
			<a href={`${base}/ko/guides/quickstart/`}>빠른 시작</a>
			<a href={`${base}/ko/guides/connect-ai-client/`}>AI 클라이언트 연결</a>
			<a href={`${base}/ko/guides/installation/`}>설치</a>
			<a href={`${base}/ko/guides/choose-your-path/`}>목적에 맞는 시작 경로</a>
		</nav>
		<nav class="footer-col" aria-label="가이드">
			<h2>가이드</h2>
			<a href={`${base}/ko/ltm/memory-persistence/`}>세션을 넘나드는 기억</a>
			<a href={`${base}/ko/ltm/index-and-import/`}>기존 자료 색인·가져오기</a>
			<a href={`${base}/ko/stm/first-proxy/`}>MCP 서버에 STM 추가</a>
			<a href={`${base}/ko/guides/troubleshooting/`}>문제 해결</a>
		</nav>
		<nav class="footer-col" aria-label="프로젝트">
			<h2>프로젝트</h2>
			<a href="https://github.com/memtomem/memtomem">GitHub (LTM)</a>
			<a href="https://github.com/memtomem/memtomem-stm">GitHub (STM)</a>
			<a href="https://pypi.org/project/memtomem/">PyPI</a>
		</nav>
	</div>
	<div class="footer-bottom">DAPADA Inc. — Apache 2.0 · memtomem v{docsContract.core.version} · memtomem-stm v{docsContract.stm.version}</div>
</footer>

<script>
	import '../../scripts/copy-button';
</script>

</body>
</html>
