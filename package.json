{
  "name": "memtomem-com",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "check:docs": "node scripts/check-doc-contract.mjs",
    "check:links": "node scripts/check-built-links.mjs",
    "check:cdn": "node scripts/check-built-cdn.mjs",
    "build": "npm run check:docs && astro build && pagefind --site dist --force-language en && npm run check:links && npm run check:cdn",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.3",
    "astro": "^6.0.1",
    "pretendard": "^1.3.9",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "hast-util-from-html": "^2.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "pagefind": "^1.5.2",
    "smol-toml": "^1.6.1",
    "starlight-llms-txt": "^0.10.0"
  }
}
